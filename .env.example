# Surcharge de src/llm/config/parameters.py.
# Priorité : variable d'environnement > .env > défaut du code.

# DATASET
MAX_DOCUMENT=70000
TRAIN_RATIO=0.80
RANDOM_SEED=42

# TOKENIZER
MAX_VOCAB_SIZE=20000
MIN_FREQUENCY=2
SPECIAL_TOKENS=<pad>,<unk>,<bos>,<eos>

# TOKENISATION
BLOCK_SIZE=512

# BITNET / TRANSFORMER
D_MODEL=640
NUM_HEADS=4
HIDDEN_DIM=500
NUM_BLOCKS=6
# MAX_SEQUENCE_LENGTH=512   # défaut = BLOCK_SIZE

# ENTRAÎNEMENT
BATCH_SIZE=6
EPOCHS=2
LEARNING_RATE=3e-5
WEIGHT_DECAY=0.01
GRADIENT_CLIP=1.0

# SAUVEGARDE PÉRIODIQUE
SAVE_EVERY_N_STEPS=1000
AUTO_CLEAN_STEP_CHECKPOINTS=true

# CHEMINS (autres chemins : voir parameters.py, ex. TRAIN_FILE, TOKENIZER_FILE)
DATA_DIR=data
PROCESSED_DIR=data/processed
TOKENIZED_DIR=data/tokenized
TOKENIZER_DIR=tokenizer
